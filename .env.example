# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# 1) Copia este archivo:      cp .env.example .env.local
# 2) Llena los valores en .env.local (ese archivo NUNCA se sube a GitHub).
# 3) En Vercel se configuran en: Project → Settings → Environment Variables.
#
# Las variables NEXT_PUBLIC_* son visibles en el navegador: nunca pongas
# secretos en ellas. Además se "congelan" al compilar (npm run build), así que
# si las cambias en Vercel debes volver a desplegar.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio (sin "/" al final). En local: http://localhost:3000
# Se usa para los enlaces de los correos (confirmar cuenta, recuperar contraseña).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre del negocio que se muestra en el sitio y en la app instalada.
NEXT_PUBLIC_BUSINESS_NAME=Estudio de Maquillaje

# WhatsApp en formato internacional, solo dígitos (ej.: 573001234567).
# Si se deja vacío, el botón flotante no aparece.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Desarrollo local: ejecuta `npm run db:start` y copia los valores que muestra
# (API URL, anon key, service_role key). Producción: Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Clave "anon" o "publishable": es pública, la seguridad real la dan las reglas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: solo servidor. Salta las reglas RLS; nunca la expongas ni la subas a GitHub.
# Se usa para el límite de intentos y para aplicar pagos ya verificados.
SUPABASE_SERVICE_ROLE_KEY=

# ── Wompi (pagos) ────────────────────────────────────────────────────────────
# Panel de Wompi → Desarrolladores → Llaves del API. Usa primero las de PRUEBAS
# (pub_test_…, test_integrity_…, test_events_…). Si se dejan vacías, la app
# funciona pero no muestra el botón de pago.
# Pública (llega al navegador):
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
# SECRETAS (solo servidor): firman el monto y verifican los avisos de Wompi.
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# En el panel de Wompi configura la "URL de eventos": https://TU-DOMINIO/api/webhooks/wompi

# ── Sentry (monitoreo de errores) ────────────────────────────────────────────
# Si se deja vacío, Sentry queda desactivado.
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir "source maps" al compilar en Vercel (opcional).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
