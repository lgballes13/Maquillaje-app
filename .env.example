# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# 1) Copia este archivo:      cp .env.example .env.local
# 2) Llena los valores en .env.local (ese archivo NUNCA se sube a GitHub).
# 3) En Vercel se configuran en: Project → Settings → Environment Variables.
#
# Las variables NEXT_PUBLIC_* son visibles en el navegador: nunca pongas
# secretos en ellas. Además se "congelan" al compilar (npm run build), así que
# si las cambias en Vercel debes volver a desplegar.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio (sin "/" al final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre del negocio que se muestra en el sitio y en la app instalada.
NEXT_PUBLIC_BUSINESS_NAME=Estudio de Maquillaje

# WhatsApp en formato internacional, solo dígitos (ej.: 573001234567).
# Si se deja vacío, el botón flotante no aparece.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Supabase (se usa desde la Fase 1) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: solo servidor. Salta las reglas RLS; nunca la expongas.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sentry (monitoreo de errores) ────────────────────────────────────────────
# Si se deja vacío, Sentry queda desactivado.
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir "source maps" al compilar en Vercel (opcional).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
